{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Billions",
  "description": "Integrate Billions payments into your application, store, or billing platform.",
  "logo": {
    "light": "/logo/logo-black.svg",
    "dark": "/logo/logo-white.svg",
    "href": "https://billions.works"
  },
  "colors": {
    "primary": "#FC4C07",
    "light": "#FC4C07",
    "dark": "#FF7138"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Instrument Sans"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111110"
    }
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:image": "https://billions.works/images/og/og-image.png",
      "twitter:image": "https://billions.works/images/og/og-image.png",
      "twitter:card": "summary_large_image"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-dark",
        "dark": "github-dark"
      }
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.billions.works"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "developer/overview"
            ]
          },
          {
            "group": "Integration guide",
            "pages": [
              "integration/overview",
              "integration/prerequisites",
              "integration/sandbox-testing",
              "integration/payment-flow",
              "integration/unified-merchant-api",
              "integration/callbacks-and-security",
              "integration/go-live-checklist"
            ]
          },
          {
            "group": "Public API",
            "pages": [
              "api/overview",
              "api/create-invoice",
              "api/request-signing",
              "api/withdrawals-and-refunds",
              {
                "group": "Live sandbox schema",
                "openapi": "https://api-sandbox.billions.works/public/v1/swagger.json",
                "pages": [
                  "POST /public/v1/invoices/create"
                ]
              }
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/create-an-invoice",
              "examples/handle-a-callback",
              "examples/get-invoices-from-api"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/overview",
              "sdks/typescript",
              "sdks/python",
              "sdks/php"
            ]
          },
          {
            "group": "Platform integrations",
            "pages": [
              "store-integrations/overview",
              "store-integrations/woocommerce",
              "store-integrations/billmanager",
              "store-integrations/whmcs",
              "store-integrations/tilda"
            ]
          }
        ]
      },
      {
        "tab": "Legal",
        "pages": [
          "legal/overview"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/integration/cryptomus-compatibility",
      "destination": "/integration/unified-merchant-api"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/billions-works"
    }
  }
}
