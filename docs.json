{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Billions",
  "description": "Integrate Billions payments into your application or online store.",
  "logo": {
    "light": "/logo/logo-black.svg",
    "dark": "/logo/logo-white.svg",
    "href": "https://billions.works"
  },
  "colors": {
    "primary": "#FC4C07",
    "light": "#FC4C07",
    "dark": "#FF7138"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Instrument Sans"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111110"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://billions.works/images/og/og-image.png",
      "twitter:image": "https://billions.works/images/og/og-image.png",
      "twitter:card": "summary_large_image"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-dark",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://billions.works"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "developer/overview"
            ]
          },
          {
            "group": "Integration guide",
            "pages": [
              "integration/overview",
              "integration/prerequisites",
              "integration/payment-flow",
              "integration/callbacks-and-security",
              "integration/go-live-checklist"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/create-an-invoice",
              "examples/handle-a-callback",
              "examples/get-invoices-from-api"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/overview",
              "sdks/typescript",
              "sdks/python",
              "sdks/php"
            ]
          },
          {
            "group": "Store integrations",
            "pages": [
              "store-integrations/overview",
              "store-integrations/woocommerce"
            ]
          }
        ]
      },
      {
        "tab": "Legal",
        "pages": [
          "legal/overview"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/billions-works"
    }
  }
}
